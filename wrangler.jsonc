{
  "name": "site-monitor",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "PROBER", "class_name": "Prober" },
      { "name": "WIDE", "class_name": "WideArea" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Prober"] },
    { "tag": "v2", "new_sqlite_classes": ["WideArea"] }
  ],
  // Keeps every Prober's 15-second alarm loop alive (re-arms it if it ever stopped).
  "triggers": { "crons": ["* * * * *"] },
  // Static dashboard from ./public; only /api/* runs the Worker first.
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] }
}
